# PT Innodesk IoT Platform - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=innodesk-iot-jwt-super-secret-key-2026-production
JWT_EXPIRES_IN=24h

# MySQL Database Configuration (Optional: fallback to embedded relational engine if unreachable)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=innodesk_iot

# IoT Background Telemetry Simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SEC=8
